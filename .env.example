# 复制本文件为 .env 并修改为真实值（.env 已被 .gitignore 排除，切勿提交）

# ---- MySQL ----
MYSQL_DATABASE=sqlearn
MYSQL_USER=sqlearn
# 请改为强密码（建议仅字母与数字，避免 shell/URL 特殊字符）
MYSQL_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# ---- 后端 ----
# JWT 签名密钥：至少 32 字符；只用字母/数字/下划线/连字符，切勿包含 $ 等特殊字符
# （.env 中 $ 会被当作变量插值，可能使密钥变短，导致后端启动失败）
APP_JWT_SECRET=please_change_me_to_a_random_string_at_least_32_chars_long

# 若模型接口使用自签名/内部 CA 证书导致 PKIX 报错，改为 true 跳过 HTTPS 证书校验
APP_AI_INSECURE_SSL=false
